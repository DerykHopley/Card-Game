{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "group": "build",
            "command": "dotnet",
            "type": "shell",
            "args": [
                "msbuild",
                "/restore",
                "/t:Build",
                "/p:Configuration=Debug",
                "/v:normal",
                "/p:GodotTargetPlatform=windows"
            ],
            "problemMatcher": "$msCompile"
        }
    ]
}